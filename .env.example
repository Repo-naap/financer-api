# =============================================================================
# FINANCER – Gestão Financeira | Configuração de Ambiente
# Copie este arquivo para .env e ajuste os valores para o seu servidor.
# =============================================================================

# Ambiente: development | production | test
NODE_ENV=production

# Porta do servidor Backend API (e frontend compilado em produção)
PORT=3001

# Banco de Dados PostgreSQL Centralizado (OBRIGATÓRIO em produção)
# Exemplo local/Docker: postgresql://financer:SENHA_FORTE_AQUI@postgres:5432/financer_db
# Exemplo nuvem (Neon/Supabase/RDS/Render): postgresql://usuario:senha@host:5432/financer_db?sslmode=require
DATABASE_URL=postgresql://financer:TROQUE_ESTA_SENHA_SEGURA@localhost:5432/financer_db

# SSL na conexão PostgreSQL (true para servidores gerenciados em nuvem)
DATABASE_SSL=false

# Chave secreta para assinatura de sessões e tokens (mínimo 32 caracteres aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=TROQUE_POR_UMA_CHAVE_ALEATORIA_FORTE_COM_MAIS_DE_32_CARACTERES

# Duração da sessão de usuário em horas (padrão: 12h)
SESSION_TTL_HOURS=12

# Origens permitidas para CORS (domínio público do escritório em produção)
CORS_ORIGIN=http://localhost:5173

# Diretório para armazenamento de backups gerados pelo sistema
BACKUP_DIR=./backups

# Caminho opcional para servir o build estático do frontend diretamente pelo backend
SERVE_FRONTEND=true
